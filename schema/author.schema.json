{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for a public author record.",
    "items": {
        "additionalProperties": false,
        "examples": [
            {
                "about": {
                    "license": "CC BY-SA 4.0",
                    "origin": {
                        "type": "human"
                    },
                    "source_url": "https://en.wikipedia.org/wiki/J._R._R._Tolkien",
                    "text": "English writer and philologist."
                },
                "id": "j-r-r-tolkien",
                "image": {
                    "license": "Public domain",
                    "source_url": "https://example.com/source",
                    "url": "https://example.com/tolkien.jpg"
                },
                "name": "J.R.R. Tolkien"
            }
        ],
        "properties": {
            "about": {
                "additionalProperties": false,
                "description": "Attributed biographical information about the author.",
                "examples": [
                    {
                        "license": "CC BY-SA 4.0",
                        "origin": {
                            "type": "human"
                        },
                        "source_url": "https://en.wikipedia.org/wiki/J._R._R._Tolkien",
                        "text": "English writer and philologist."
                    }
                ],
                "properties": {
                    "license": {
                        "description": "License under which the biographical text may be used.",
                        "examples": [
                            "CC BY-SA 4.0"
                        ],
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "origin": {
                        "additionalProperties": false,
                        "description": "Information about how the biographical text was produced.",
                        "examples": [
                            {
                                "type": "human"
                            }
                        ],
                        "properties": {
                            "type": {
                                "description": "Origin of the biographical text: human-written, AI-generated, or AI-assisted.",
                                "enum": [
                                    "human",
                                    "ai",
                                    "ai_assisted"
                                ],
                                "examples": [
                                    "human"
                                ],
                                "type": "string"
                            }
                        },
                        "required": [
                            "type"
                        ],
                        "type": "object"
                    },
                    "source_url": {
                        "description": "URL identifying the source of the biographical text.",
                        "examples": [
                            "https://en.wikipedia.org/wiki/J._R._R._Tolkien"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    },
                    "text": {
                        "description": "Biographical text describing the author.",
                        "examples": [
                            "English writer and philologist."
                        ],
                        "maxLength": 512,
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                    }
                },
                "required": [
                    "text",
                    "license",
                    "source_url",
                    "origin"
                ],
                "type": "object"
            },
            "id": {
                "description": "Permanent, globally unique identifier for the author. Construct this by taking the author's name and converting it to lowercase, replacing spaces with hyphens, and ensuring it is unique. Try not to change this unless there is a good reason.",
                "examples": [
                    "j-r-r-tolkien",
                    "ursula-k-le-guin"
                ],
                "minLength": 1,
                "type": "string"
            },
            "image": {
                "additionalProperties": false,
                "description": "Image and attribution metadata for the author.",
                "examples": [
                    {
                        "license": "Public domain",
                        "source_url": "https://commons.wikimedia.org/wiki/File:J._R._R._Tolkien,_1940s.jpg"
                    }
                ],
                "properties": {
                    "license": {
                        "description": "License under which the image may be used.",
                        "examples": [
                            "Public domain"
                        ],
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "source_url": {
                        "description": "URL identifying the original image source.",
                        "examples": [
                            "https://commons.wikimedia.org/wiki/File:J._R._R._Tolkien,_1940s.jpg"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    }
                },
                "required": [
                    "source_url",
                    "license"
                ],
                "type": "object"
            },
            "name": {
                "description": "Public display name of the author.",
                "examples": [
                    "J.R.R. Tolkien"
                ],
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
            },
            "social_links": {
                "additionalProperties": false,
                "description": "Public social or reference links associated with the author.",
                "examples": [
                    {
                        "instagram": "https://www.instagram.com/example_author",
                        "website": "https://www.example.com",
                        "wikipedia": "https://en.wikipedia.org/wiki/J._R._R._Tolkien",
                        "x": "https://x.com/example_author",
                        "youtube": "https://www.youtube.com/@example_author"
                    }
                ],
                "properties": {
                    "instagram": {
                        "description": "URL of the author's Instagram profile.",
                        "examples": [
                            "https://www.instagram.com/example_author"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    },
                    "website": {
                        "description": "URL of the author's website.",
                        "examples": [
                            "https://www.example.com"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    },
                    "wikipedia": {
                        "description": "URL of the author's Wikipedia entry.",
                        "examples": [
                            "https://en.wikipedia.org/wiki/J._R._R._Tolkien"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    },
                    "x": {
                        "description": "URL of the author's X profile.",
                        "examples": [
                            "https://x.com/example_author"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    },
                    "youtube": {
                        "description": "URL of the author's YouTube channel.",
                        "examples": [
                            "https://www.youtube.com/@example_author"
                        ],
                        "format": "uri",
                        "pattern": "^https?://",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        },
        "required": [
            "id",
            "name",
            "image",
            "about"
        ],
        "type": "object"
    },
    "title": "Epilogue Authors Dataset",
    "type": "array"
}
